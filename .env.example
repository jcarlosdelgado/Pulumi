# ==============================================================================
# PLANTILLA DE CONFIGURACION DE CREDENCIALES AWS (.env.example)
# ==============================================================================
# NOTA DE SEGURIDAD:
# Copia este archivo como '.env' en la raiz del proyecto y coloca tus valores.
# El archivo '.env' esta excluido por .gitignore y NUNCA se subira a Git.
# ==============================================================================

# Credenciales de acceso de AWS IAM:
AWS_ACCESS_KEY_ID=AKIAEXAMPLEACCESSKEY
AWS_SECRET_ACCESS_KEY=exampleSecretKeyNotReal1234567890abc
AWS_REGION=us-east-1

# Token de sesion temporal (requerido solo si usas AWS Academy, SSO o roles asumidos):
# AWS_SESSION_TOKEN=

# Contrasena para el gestor de secretos local de Pulumi:
PULUMI_CONFIG_PASSPHRASE=dev
